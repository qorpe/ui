{
  "name": "@qorpe/ui",
  "version": "0.1.1",
  "description": "The qorpe family UI kit: the ui-standard tokens, primitives and composites every qorpe console composes from.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qorpe/ui.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./json-editor": {
      "types": "./dist/json-editor/index.d.ts",
      "import": "./dist/json-editor/index.js"
    }
  },
  "scripts": {
    "build": "tsup && cp src/tokens/tokens.css dist/tokens.css",
    "test": "vitest run --coverage --coverage.thresholds.statements=95 --coverage.thresholds.branches=90 --coverage.thresholds.functions=75 --coverage.thresholds.lines=95",
    "typecheck": "tsc --noEmit",
    "gallery": "vite",
    "pin-gate": "./scripts/pin-gate.sh",
    "changeset": "changeset",
    "release:publish": "changeset publish"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.7",
    "@lezer/highlight": "1.2.3",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tooltip": "1.2.8",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.27.0"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.5",
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "2.1.8",
    "axe-core": "4.10.2",
    "jsdom": "25.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.83.0",
    "tailwindcss": "4.3.2",
    "tsup": "8.3.5",
    "typescript": "5.9.3",
    "vite": "8.1.4",
    "vitest": "2.1.9"
  },
  "packageManager": "pnpm@10.28.2"
}
